# Copy to .env.local and fill in real values. Never commit .env.local.
# Backend mode selection: 'mock' (default), 'server' (local Node REST API on port 3001), or 'supabase'
VITE_BACKEND=server
VITE_API_URL=/api
PORT=3001

# Supabase (M4):
VITE_USE_MOCK=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEMO_PASSWORD=Demo@2026

# Google Gemini API for AI routing & multilingual grievance translation:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Notification Service:
RESEND_API_KEY=
